 * exactly one branch; inventory, sales, and customers are scoped by branch_id.
 */
class BranchService
{
    /**
     * Create a new branch.
     *
     * Wrapped in a transaction because creation also writes an audit log
     * entry — both must succeed or neither should.
     *
     * @param  array  $data  Validated data from StoreBranchRequest
     * @return Branch        The newly created branch
     */
    public function createBranch(array $data): Branch
    {
        // ...
    }
}
